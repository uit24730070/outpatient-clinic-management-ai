# =============================================================================
# Clinic Management AI — Mẫu biến môi trường
# Sao chép file này thành .env và điền giá trị thực tế. KHÔNG commit file .env.
# =============================================================================

# --- Backend / ASP.NET Core -------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinic_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Chuỗi kết nối tổng hợp (dùng bởi backend)
# CONNECTION_STRING=Host=localhost;Port=5432;Database=clinic_management;Username=postgres;Password=change_me

# --- LLM API ----------------------------------------------------------------
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
