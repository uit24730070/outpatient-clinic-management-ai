# =============================================================================
# Clinic Management AI — Mẫu biến môi trường
# Sao chép file này thành .env và điền giá trị thực tế. KHÔNG commit file .env.
# .env được docker-compose.yml đọc tự động.
# =============================================================================

# --- PostgreSQL (dịch vụ db) ------------------------------------------------
POSTGRES_DB=clinic_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# Cổng PostgreSQL map ra host (đổi nếu 5432 đã bận).
POSTGRES_PORT=5432

# --- Backend API (dịch vụ api) ----------------------------------------------
# Khoá ký JWT — BẮT BUỘC, tối thiểu 32 byte. Sinh ngẫu nhiên, KHÔNG dùng giá trị mẫu này thật.
JWT_KEY=doi-thanh-mot-chuoi-bi-mat-ngau-nhien-toi-thieu-32-byte
# Cổng API map ra host (Swagger tắt ở Production).
API_PORT=5006

# --- Frontend (dịch vụ web) -------------------------------------------------
# Cổng truy cập giao diện web trên host → http://localhost:${WEB_PORT}
WEB_PORT=8080

# --- Trợ lý AI / LLM --------------------------------------------------------
# Mặc định dùng bản fake (không gọi mạng, không cần khoá) để demo dựng nhanh.
# Đặt =false và điền khoá bên dưới để bật OpenAI API (GPT-5 mini) + Voyage embeddings (RAG).
AI_USE_FAKE=true
AI_USE_FAKE_EMBEDDING=true
AI_API_KEY=
AI_EMBEDDING_API_KEY=
