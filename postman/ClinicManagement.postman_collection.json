            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/doctors", "host": [ "{{baseUrl}}" ], "path": [ "api", "doctors" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn A\",\n  \"specialtyId\": \"{{specialtyId}}\",\n  \"phoneNumber\": \"0912345678\",\n  \"email\": \"a@clinic.vn\"\n}"
            }
          }
        },
        {
          "name": "List doctors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors?page=1&pageSize=20&search=",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "doctors" ],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get doctor by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/doctors/{{doctorId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "doctors", "{{doctorId}}" ] }
          }
        },
        {
          "name": "Update doctor",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/doctors/{{doctorId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "doctors", "{{doctorId}}" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn An\",\n  \"specialtyId\": \"{{specialtyId}}\",\n  \"phoneNumber\": \"0900000000\",\n  \"email\": \"an@clinic.vn\"\n}"
            }
          }
        },
        {
          "name": "Delete doctor (soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/doctors/{{doctorId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "doctors", "{{doctorId}}" ] }
          }
        }
      ]
    }
  ]
}
