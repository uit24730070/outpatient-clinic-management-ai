     "name": "Summarize patient (AI)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200 OK', () => pm.response.code === 200);",
         "const body = pm.response.json();",
         "pm.test('có summary', () => body.success && typeof body.data.summary === 'string');"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/patients/{{patientId}}/ai-summary",
       "host": [
