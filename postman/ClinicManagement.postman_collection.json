{
 "info": {
  "name": "Clinic Management AI",
  "description": "Bộ sưu tập kiểm thử API. Sprint 1: Bệnh nhân. Sprint 2: Chuyên khoa, Bác sĩ, soft delete, health check. Sprint 3: Xác thực (JWT) + RBAC. Sprint 4: Lịch khám (đặt lịch, check-in, vòng đời trạng thái). Sprint 5: Khám bệnh & Bệnh án (phiếu khám + đơn thuốc + lịch sử). Chạy 'Auth > Login' trước để đặt biến {{token}}; token được áp tự động cho mọi request qua Bearer cấp collection.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
