    {
     "name": "Login (admin)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200 OK', () => pm.response.code === 200);",
         "const body = pm.response.json();",
         "if (body.success) pm.collectionVariables.set('token', body.data.accessToken);"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/auth/login",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "auth",
        "login"
       ]
      },
