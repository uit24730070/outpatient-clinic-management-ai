{
  "info": {
    "name": "Clinic Management AI",
    "description": "Bộ sưu tập kiểm thử API. Sprint 1: Bệnh nhân. Sprint 2: Chuyên khoa, Bác sĩ, soft delete, health check. Sprint 3: Xác thực (JWT) + RBAC. Chạy 'Auth > Login' trước để đặt biến {{token}}; token được áp tự động cho mọi request qua Bearer cấp collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5006" },
    { "key": "token", "value": "" },
    { "key": "patientId", "value": "" },
    { "key": "specialtyId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "doctorId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.code === 200);",
                  "const body = pm.response.json();",
                  "if (body.success) pm.collectionVariables.set('token', body.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "login" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Me (current user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "me" ] }
          }
        }
      ]
    },
    {
      "name": "Ops",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": [ "{{baseUrl}}" ], "path": [ "health" ] }
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Create patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.code === 201);",
                  "const body = pm.response.json();",
                  "if (body.success) pm.collectionVariables.set('patientId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/patients", "host": [ "{{baseUrl}}" ], "path": [ "api", "patients" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn A\",\n  \"dateOfBirth\": \"1990-05-20\",\n  \"gender\": 1,\n  \"phoneNumber\": \"0912345678\",\n  \"address\": \"Hà Nội\"\n}"
            }
          }
        },
        {
          "name": "List patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients?page=1&pageSize=20&search=",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "patients" ],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get patient by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/patients/{{patientId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "patients", "{{patientId}}" ] }
          }
        },
        {
          "name": "Update patient",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/patients/{{patientId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "patients", "{{patientId}}" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn An\",\n  \"dateOfBirth\": \"1990-05-20\",\n  \"gender\": 1,\n  \"phoneNumber\": \"0900000000\",\n  \"address\": \"TP.HCM\"\n}"
            }
          }
        },
        {
          "name": "Delete patient (soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/patients/{{patientId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "patients", "{{patientId}}" ] }
          }
        }
      ]
    },
    {
      "name": "Specialties",
