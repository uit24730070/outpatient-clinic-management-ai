                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/specialties", "host": [ "{{baseUrl}}" ], "path": [ "api", "specialties" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ngoại tổng quát\",\n  \"description\": \"Khoa ngoại.\"\n}"
            }
          }
        },
        {
          "name": "List specialties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/specialties?page=1&pageSize=20&search=",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "specialties" ],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Update specialty",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/specialties/{{specialtyId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "specialties", "{{specialtyId}}" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ngoại tổng quát\",\n  \"description\": \"Cập nhật mô tả.\"\n}"
            }
          }
        },
        {
          "name": "Delete specialty (soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/specialties/{{specialtyId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "specialties", "{{specialtyId}}" ] }
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Create doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.code === 201);",
                  "const body = pm.response.json();",
                  "if (body.success) pm.collectionVariables.set('doctorId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
