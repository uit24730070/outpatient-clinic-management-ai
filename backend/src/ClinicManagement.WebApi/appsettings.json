{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=clinic_management;Username=postgres;Password=change_me"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "ClinicManagement",
    "Audience": "ClinicManagementClient",
    "Key": "",
    "ExpiresMinutes": 120
  },
  "Ai": {
    "ApiKey": "",
    "Model": "gpt-5-mini",
    "BaseUrl": "https://api.openai.com",
    "ReasoningEffort": "low",
    "MaxTokens": 2048,
    "TimeoutSeconds": 120,
    "UseFake": false,
    "EmbeddingApiKey": "",
    "EmbeddingModel": "voyage-3",
    "EmbeddingBaseUrl": "https://api.voyageai.com",
    "UseFakeEmbedding": false
  }
}
