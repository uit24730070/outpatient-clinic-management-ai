@host = http://localhost:5006

######################## Xác thực ########################

### Đăng nhập (lưu token vào biến @token qua tên request "login")
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin@123"
}

### Lấy token từ phản hồi login ở trên
@token = {{login.response.body.$.data.accessToken}}

### Thông tin người dùng hiện tại
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

######################## Bệnh nhân ########################
# Các endpoint dưới đây yêu cầu header Authorization: Bearer {{token}}.

### Tạo bệnh nhân
POST {{host}}/api/patients
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Nguyễn Văn A",
  "dateOfBirth": "1990-05-20",
  "gender": 1,
  "phoneNumber": "0912345678",
  "address": "Hà Nội"
}

### Danh sách bệnh nhân (phân trang + tìm kiếm)
GET {{host}}/api/patients?page=1&pageSize=20&search=Nguyễn
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết bệnh nhân
GET {{host}}/api/patients/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Accept: application/json

### Cập nhật bệnh nhân
PUT {{host}}/api/patients/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Nguyễn Văn An",
  "dateOfBirth": "1990-05-20",
  "gender": 1,
  "phoneNumber": "0900000000",
  "address": "TP.HCM"
}

### Xoá mềm bệnh nhân
DELETE {{host}}/api/patients/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

######################## Vận hành ########################

### Health check
GET {{host}}/health

######################## Chuyên khoa ########################

### Tạo chuyên khoa
POST {{host}}/api/specialties
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tim mạch",
  "description": "Chẩn đoán và điều trị bệnh lý tim mạch."
}

### Danh sách chuyên khoa
GET {{host}}/api/specialties?page=1&pageSize=20&search=
Authorization: Bearer {{token}}
Accept: application/json

### Cập nhật chuyên khoa
PUT {{host}}/api/specialties/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Nội tổng quát",
  "description": "Cập nhật mô tả."
}

### Xoá mềm chuyên khoa
DELETE {{host}}/api/specialties/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}

######################## Bác sĩ ########################

### Tạo bác sĩ (specialtyId là chuyên khoa seed sẵn: Tim mạch)
POST {{host}}/api/doctors
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Nguyễn Văn A",
  "specialtyId": "22222222-2222-2222-2222-222222222222",
  "phoneNumber": "0912345678",
  "email": "a@clinic.vn"
}

### Danh sách bác sĩ (phân trang + tìm kiếm)
GET {{host}}/api/doctors?page=1&pageSize=20&search=
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết bác sĩ
GET {{host}}/api/doctors/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Accept: application/json

### Cập nhật bác sĩ
PUT {{host}}/api/doctors/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Nguyễn Văn An",
  "specialtyId": "11111111-1111-1111-1111-111111111111",
  "phoneNumber": "0900000000",
  "email": "an@clinic.vn"
}

### Xoá mềm bác sĩ
DELETE {{host}}/api/doctors/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

######################## Lịch khám ########################
# Thay patientId/doctorId bằng Id thật (lấy từ danh sách Bệnh nhân/Bác sĩ).

### Đặt lịch khám (lưu Id vào biến qua tên request "appt")
# @name appt
POST {{host}}/api/appointments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "patientId": "11111111-1111-1111-1111-111111111111",
  "doctorId": "22222222-2222-2222-2222-222222222222",
  "startTime": "2026-08-10T08:00:00Z",
  "endTime": "2026-08-10T08:30:00Z",
  "reason": "Khám tổng quát",
  "servicePriceId": null
}

### Lấy Id lịch vừa tạo
@appointmentId = {{appt.response.body.$.data.id}}

### Lượt gần nhất của bệnh nhân (prefill dịch vụ khi tái khám; ADR 0016)
GET {{host}}/api/appointments/last?patientId=11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}

### Danh sách/hàng đợi (lọc theo ngày + bác sĩ + trạng thái)
GET {{host}}/api/appointments?date=2026-08-10&status=0
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết lịch
GET {{host}}/api/appointments/{{appointmentId}}
Authorization: Bearer {{token}}
Accept: application/json

### Đổi khung giờ/lý do (reschedule)
PUT {{host}}/api/appointments/{{appointmentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "startTime": "2026-08-10T09:00:00Z",
  "endTime": "2026-08-10T09:30:00Z",
  "reason": "Đổi giờ"
}

### Check-in (Scheduled -> CheckedIn)
POST {{host}}/api/appointments/{{appointmentId}}/check-in
Authorization: Bearer {{token}}

### Bắt đầu khám (CheckedIn -> InProgress)
POST {{host}}/api/appointments/{{appointmentId}}/start
Authorization: Bearer {{token}}

### Hoàn tất (InProgress -> Completed)
POST {{host}}/api/appointments/{{appointmentId}}/complete
Authorization: Bearer {{token}}

### Huỷ lịch
POST {{host}}/api/appointments/{{appointmentId}}/cancel
Authorization: Bearer {{token}}

### Không đến
POST {{host}}/api/appointments/{{appointmentId}}/no-show
Authorization: Bearer {{token}}

### Xoá mềm lịch
DELETE {{host}}/api/appointments/{{appointmentId}}
Authorization: Bearer {{token}}

######################## Khám bệnh & Bệnh án ########################
# Điều kiện: lịch {{appointmentId}} phải ở trạng thái InProgress (đã check-in + start).
# Ghi phiếu khám cần vai trò Bác sĩ hoặc Admin.

### Tạo phiếu khám cho lịch đang khám (lưu Id vào biến qua tên "enc")
# @name enc
POST {{host}}/api/encounters
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "appointmentId": "{{appointmentId}}",
  "symptoms": "Sốt, ho, đau họng",
  "diagnosis": "Viêm họng cấp",
  "notes": "Nghỉ ngơi, uống nhiều nước",
  "prescriptionItems": [
    { "medicationId": "{{medicationId}}", "drugName": "Paracetamol", "dosage": "500mg", "quantity": 10, "instruction": "Ngày 2 lần sau ăn" },
    { "drugName": "Vitamin C", "dosage": "1000mg", "quantity": 5, "instruction": null }
  ]
}
# Lưu ý: dòng có "medicationId" (thuốc trong danh mục) sẽ được cấp phát trừ tồn FEFO khi chốt phiếu;
# dòng không có "medicationId" là thuốc ngoài danh mục (không trừ tồn). Cần đã nhập kho đủ tồn.

### Lấy Id phiếu vừa tạo
@encounterId = {{enc.response.body.$.data.id}}

### Lịch sử khám của bệnh nhân (mới nhất trước) — thay patientId bằng Id thật
GET {{host}}/api/encounters?patientId=11111111-1111-1111-1111-111111111111&page=1&pageSize=20
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết phiếu khám (kèm đơn thuốc)
GET {{host}}/api/encounters/{{encounterId}}
Authorization: Bearer {{token}}
Accept: application/json

### Lấy phiếu theo lịch khám (1–1)
GET {{host}}/api/encounters/by-appointment/{{appointmentId}}
Authorization: Bearer {{token}}
Accept: application/json

### Sửa phiếu + thay toàn bộ đơn thuốc (chỉ khi còn Draft)
PUT {{host}}/api/encounters/{{encounterId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "symptoms": "Sốt cao 39°C",
  "diagnosis": "Cúm mùa",
  "notes": null,
  "prescriptionItems": [
    { "drugName": "Oseltamivir", "dosage": "75mg", "quantity": 10, "instruction": "Ngày 2 lần" }
  ]
}

### Chốt phiếu (Draft -> Completed; khép lịch khám + CẤP PHÁT thuốc FEFO)
# Cho phép cả ba vai trò (Roles.DispenseEncounter). Thiếu tồn -> 409 Pharmacy.InsufficientStock (rollback).
POST {{host}}/api/encounters/{{encounterId}}/complete
Authorization: Bearer {{token}}

######################## Trợ lý AI ########################
# Cần vai trò Bác sĩ hoặc Admin. Dev bật Ai:UseFake = true → trả tóm tắt mô phỏng, không gọi mạng.
# Thay patientId bằng Id thật (lấy từ danh sách Bệnh nhân).

### Tóm tắt lịch sử khám của bệnh nhân bằng AI
POST {{host}}/api/patients/11111111-1111-1111-1111-111111111111/ai-summary
Authorization: Bearer {{token}}
Accept: application/json

### Hỏi đáp có ngữ cảnh (RAG) trên bệnh án — trả câu trả lời + nguồn phiếu
# Dev bật Ai:UseFakeEmbedding = true → embedding tất định, không gọi mạng.
POST {{host}}/api/patients/11111111-1111-1111-1111-111111111111/ai-ask
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "question": "Bệnh nhân từng dùng kháng sinh gì?"
}

### Backfill embedding cho toàn bộ phiếu khám (Admin — bảo trì)
POST {{host}}/api/ai/reindex
Authorization: Bearer {{token}}
Accept: application/json

######################## Trợ lý hội thoại (AI-03) ########################
# Mọi vai trò đã đăng nhập. Dev bật Ai:UseFake = true → trả lời tất định, không gọi mạng.
# Phạm vi dữ liệu do lớp công cụ kiểm soát theo vai trò (bác sĩ chỉ dữ liệu của mình).

### Hỏi trợ lý (một lượt)
POST {{host}}/api/assistant/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "messages": [
    { "role": "user", "content": "Hôm nay có bao nhiêu lịch khám đang chờ?" }
  ]
}

### Hỏi trợ lý (nhiều lượt — gửi lại toàn bộ lịch sử)
POST {{host}}/api/assistant/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "messages": [
    { "role": "user", "content": "Tìm bệnh nhân tên Nguyễn Văn A" },
    { "role": "assistant", "content": "Tôi tìm thấy bệnh nhân Nguyễn Văn A (BN-000001)." },
    { "role": "user", "content": "Xem lịch sử khám của bệnh nhân đó" }
  ]
}

######################## Quản lý người dùng (Admin) ########################
# Mọi endpoint /api/users chỉ Admin. role nhận CHUỖI ("Admin"/"Receptionist"/"Doctor").

### Tạo tài khoản mới
POST {{host}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "letan1",
  "password": "MatKhau@123",
  "fullName": "Lễ Tân Một",
  "role": "Receptionist",
  "email": null
}

### Danh sách người dùng (lọc theo vai trò/trạng thái)
GET {{host}}/api/users?page=1&pageSize=20&role=Doctor&isActive=true
Authorization: Bearer {{token}}

### Chi tiết một người dùng
GET {{host}}/api/users/{{userId}}
Authorization: Bearer {{token}}

### Cập nhật hồ sơ tài khoản (không đổi username/mật khẩu)
PUT {{host}}/api/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Lễ Tân Một (đã sửa)",
  "role": "Receptionist",
  "email": "letan1@clinic.vn"
}

### Đặt lại mật khẩu
POST {{host}}/api/users/{{userId}}/reset-password
Authorization: Bearer {{token}}
Content-Type: application/json

{ "newPassword": "MatKhauMoi@9" }

### Khoá / mở khoá đăng nhập
POST {{host}}/api/users/{{userId}}/deactivate
Authorization: Bearer {{token}}

###
POST {{host}}/api/users/{{userId}}/activate
Authorization: Bearer {{token}}

### Xoá mềm tài khoản
DELETE {{host}}/api/users/{{userId}}
Authorization: Bearer {{token}}

######################## Gắn/gỡ User <-> Doctor (Admin) ########################

### Gắn tài khoản (role Doctor) vào hồ sơ bác sĩ
POST {{host}}/api/doctors/{{doctorId}}/link-user
Authorization: Bearer {{token}}
Content-Type: application/json

{ "userId": "{{userId}}" }

### Gỡ liên kết tài khoản khỏi hồ sơ bác sĩ
POST {{host}}/api/doctors/{{doctorId}}/unlink-user
Authorization: Bearer {{token}}

######################## Kho thuốc (Pharmacy) ########################

### Danh sách thuốc (kèm tồn tổng)
GET {{host}}/api/medications?page=1&pageSize=20
Authorization: Bearer {{token}}

### Tạo thuốc mới
# @name createMedication
POST {{host}}/api/medications
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Ibuprofen 400mg",
  "activeIngredient": "Ibuprofen",
  "unit": "viên",
  "reorderLevel": 50,
  "description": "Giảm đau, kháng viêm"
}

### Lấy Id thuốc vừa tạo
@medicationId = {{createMedication.response.body.$.data.id}}

### Chi tiết thuốc
GET {{host}}/api/medications/{{medicationId}}
Authorization: Bearer {{token}}

### Danh sách lô của thuốc
GET {{host}}/api/medications/{{medicationId}}/batches
Authorization: Bearer {{token}}

### Cập nhật thuốc
PUT {{host}}/api/medications/{{medicationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Ibuprofen 400mg",
  "activeIngredient": "Ibuprofen",
  "unit": "viên",
  "reorderLevel": 80,
  "description": null
}

### Nhập kho (tăng tồn theo lô + ghi sổ cái Import)
POST {{host}}/api/stock-receipts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "supplierName": "Công ty Dược ABC",
  "receivedAt": "2026-08-22T00:00:00Z",
  "note": "Nhập đầu kỳ",
  "items": [
    { "medicationId": "{{medicationId}}", "batchNumber": "L2608", "expiryDate": "2027-12-31", "quantity": 40, "unitCost": 1500 }
  ]
}

### Danh sách phiếu nhập
GET {{host}}/api/stock-receipts?page=1&pageSize=20
Authorization: Bearer {{token}}

### Sổ cái giao dịch tồn (lọc theo thuốc; bỏ type để xem cả Import + Dispense)
GET {{host}}/api/stock-transactions?medicationId={{medicationId}}
Authorization: Bearer {{token}}

### Cảnh báo kho: tồn thấp + lô sắp/đã hết hạn (Admin/Lễ tân)
GET {{host}}/api/pharmacy/alerts?expiringInDays=30
Authorization: Bearer {{token}}

### Xoá mềm thuốc
DELETE {{host}}/api/medications/{{medicationId}}
Authorization: Bearer {{token}}

###############################################
# Viện phí & Thu ngân (Sprint 14, ManageBilling = Admin/Lễ tân)
###############################################

### Bảng giá dịch vụ — danh sách
GET {{host}}/api/service-prices?page=1&pageSize=20
Authorization: Bearer {{token}}

### Tạo dịch vụ (sinh mã DV-)
POST {{host}}/api/service-prices
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tư vấn dinh dưỡng",
  "unitPrice": 80000,
  "description": null
}

### Lập HĐ THUỐC từ phiếu khám (Mô hình A — chỉ dòng thuốc đã cấp; phiếu phải Completed; lập lần 2 → 409)
POST {{host}}/api/invoices/from-encounter/{{encounterId}}
Authorization: Bearer {{token}}

### Tạo hoá đơn DỊCH VỤ / LÚC TIẾP ĐÓN (dòng servicePriceId; appointmentId tuỳ chọn để gắn lượt)
POST {{host}}/api/invoices
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "patientId": "{{patientId}}",
  "note": null,
  "appointmentId": "{{appointmentId}}",
  "items": [
    { "servicePriceId": "{{servicePriceId}}", "quantity": 1 }
  ]
}

### Danh sách hoá đơn (lọc trạng thái: 0=Draft, 1=Paid, 2=Cancelled; lọc theo lượt)
GET {{host}}/api/invoices?page=1&pageSize=20&status=0&appointmentId={{appointmentId}}
Authorization: Bearer {{token}}

### Gom hoá đơn theo LƯỢT + tổng đã lập/đã thu/còn nợ
GET {{host}}/api/invoices/by-appointment/{{appointmentId}}
Authorization: Bearer {{token}}

### Chi tiết hoá đơn
GET {{host}}/api/invoices/{{invoiceId}}
Authorization: Bearer {{token}}

### Thu tiền (paymentMethod nhận CHUỖI: Cash/Card/Transfer)
POST {{host}}/api/invoices/{{invoiceId}}/pay
Authorization: Bearer {{token}}
Content-Type: application/json

{ "paymentMethod": "Cash" }

### Huỷ hoá đơn (chỉ khi Draft)
POST {{host}}/api/invoices/{{invoiceId}}/cancel
Authorization: Bearer {{token}}

### ───────────────────────────── Cận lâm sàng (Sprint 15, Epic 11) ─────────────────────────────

### Danh mục dịch vụ CLS (lọc category: 0=Consultation, 1=Paraclinical, 2=Other)
GET {{host}}/api/service-prices?page=1&pageSize=50&category=1
Authorization: Bearer {{token}}

### Chỉ định CLS từ phiếu khám (phiếu phải Draft; dịch vụ phải loại Paraclinical → sinh mã CLS-)
# @name createLabOrder
POST {{host}}/api/lab-orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "encounterId": "{{encounterId}}",
  "note": "Chỉ định thường quy",
  "items": [
    { "servicePriceId": "{{servicePriceId}}" }
  ]
}

### Đăng ký CLS walk-in (lễ tân — không cần phiếu khám; ADR 0016; RBAC ManageStaff)
# @name createWalkInLabOrder
POST {{host}}/api/lab-orders/walk-in
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "patientId": "{{patientId}}",
  "appointmentId": null,
  "visitId": null,
  "note": "Bệnh nhân yêu cầu",
  "items": [
    { "servicePriceId": "{{servicePriceId}}" }
  ]
}

### Hàng chờ Kỹ thuật viên (đăng nhập kythuatvien/Technician@123; lọc trạng thái Ordered/InProgress)
GET {{host}}/api/lab-orders?page=1&pageSize=50&status=0
Authorization: Bearer {{token}}

### Danh sách phiếu chỉ định (lọc theo phiếu khám/bệnh nhân/trạng thái 0..3)
GET {{host}}/api/lab-orders?page=1&pageSize=20&encounterId={{encounterId}}
Authorization: Bearer {{token}}

### Chi tiết phiếu chỉ định
GET {{host}}/api/lab-orders/{{labOrderId}}
Authorization: Bearer {{token}}

### Nhập kết quả cho một mục (đủ mục có kết quả → phiếu Completed)
POST {{host}}/api/lab-orders/{{labOrderId}}/items/{{labOrderItemId}}/result
Authorization: Bearer {{token}}
Content-Type: application/json

{ "resultText": "WBC 7.5 — bình thường", "conclusion": "Không bất thường" }

### Huỷ phiếu chỉ định (chỉ khi chưa Completed/Cancelled)
POST {{host}}/api/lab-orders/{{labOrderId}}/cancel
Authorization: Bearer {{token}}

### Lập HĐ phí CLS từ phiếu chỉ định (dòng Paraclinical; lập lần 2 → 409; RBAC ManageBilling)
POST {{host}}/api/invoices/from-lab-order/{{labOrderId}}
Authorization: Bearer {{token}}

###############################################
# Lượt tiếp đón (Visit) — ADR 0017
###############################################

### Tạo lượt tiếp đón + nhiều dịch vụ khám (walk-in; RBAC ManageStaff)
POST {{host}}/api/visits
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "patientId": "{{patientId}}",
  "note": "Lượt sáng",
  "services": [
    { "doctorId": "{{doctorId}}", "startTime": "2026-09-10T01:00:00Z", "endTime": "2026-09-10T01:30:00Z", "reason": "Khám nội", "servicePriceId": "{{servicePriceId}}" },
    { "doctorId": "{{doctorId}}", "startTime": "2026-09-10T02:00:00Z", "endTime": "2026-09-10T02:30:00Z", "reason": "Tái khám", "servicePriceId": "{{servicePriceId}}" }
  ]
}

### Danh sách lượt (lọc ngày/bệnh nhân/trạng thái 0..2)
GET {{host}}/api/visits?page=1&pageSize=20
Authorization: Bearer {{token}}

### Chi tiết lượt (kèm tổng viện phí gom cả lượt)
GET {{host}}/api/visits/{{visitId}}
Authorization: Bearer {{token}}

### Thêm dịch vụ khám vào lượt đang mở
POST {{host}}/api/visits/{{visitId}}/services
Authorization: Bearer {{token}}
Content-Type: application/json

{ "doctorId": "{{doctorId}}", "startTime": "2026-09-10T03:00:00Z", "endTime": "2026-09-10T03:30:00Z", "reason": "Khám thêm", "servicePriceId": "{{servicePriceId}}" }

### Đóng lượt (Open → Closed)
POST {{host}}/api/visits/{{visitId}}/close
Authorization: Bearer {{token}}

### Huỷ lượt (Open → Cancelled)
POST {{host}}/api/visits/{{visitId}}/cancel
Authorization: Bearer {{token}}

### Gom hoá đơn theo lượt tiếp đón + tổng (ADR 0017)
GET {{host}}/api/invoices/by-visit/{{visitId}}
Authorization: Bearer {{token}}

### Thu tiền cả lượt (mọi HĐ Draft của lượt; RBAC ManageBilling)
