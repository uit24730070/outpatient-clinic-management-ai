@host = http://localhost:5006

######################## Xác thực ########################

### Đăng nhập (lưu token vào biến @token qua tên request "login")
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin@123"
}

### Lấy token từ phản hồi login ở trên
@token = {{login.response.body.$.data.accessToken}}

### Thông tin người dùng hiện tại
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

######################## Bệnh nhân ########################
# Các endpoint dưới đây yêu cầu header Authorization: Bearer {{token}}.

### Tạo bệnh nhân
POST {{host}}/api/patients
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Nguyễn Văn A",
  "dateOfBirth": "1990-05-20",
  "gender": 1,
  "phoneNumber": "0912345678",
  "address": "Hà Nội"
}

### Danh sách bệnh nhân (phân trang + tìm kiếm)
GET {{host}}/api/patients?page=1&pageSize=20&search=Nguyễn
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết bệnh nhân
GET {{host}}/api/patients/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Accept: application/json

### Cập nhật bệnh nhân
PUT {{host}}/api/patients/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Nguyễn Văn An",
  "dateOfBirth": "1990-05-20",
  "gender": 1,
  "phoneNumber": "0900000000",
  "address": "TP.HCM"
}

### Xoá mềm bệnh nhân
DELETE {{host}}/api/patients/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

######################## Vận hành ########################

### Health check
GET {{host}}/health

######################## Chuyên khoa ########################

### Tạo chuyên khoa
POST {{host}}/api/specialties
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tim mạch",
  "description": "Chẩn đoán và điều trị bệnh lý tim mạch."
}

### Danh sách chuyên khoa
GET {{host}}/api/specialties?page=1&pageSize=20&search=
Authorization: Bearer {{token}}
Accept: application/json

### Cập nhật chuyên khoa
PUT {{host}}/api/specialties/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Nội tổng quát",
  "description": "Cập nhật mô tả."
}

### Xoá mềm chuyên khoa
DELETE {{host}}/api/specialties/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}

######################## Bác sĩ ########################

### Tạo bác sĩ (specialtyId là chuyên khoa seed sẵn: Tim mạch)
POST {{host}}/api/doctors
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Nguyễn Văn A",
  "specialtyId": "22222222-2222-2222-2222-222222222222",
  "phoneNumber": "0912345678",
  "email": "a@clinic.vn"
}

### Danh sách bác sĩ (phân trang + tìm kiếm)
GET {{host}}/api/doctors?page=1&pageSize=20&search=
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết bác sĩ
GET {{host}}/api/doctors/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Accept: application/json

### Cập nhật bác sĩ
PUT {{host}}/api/doctors/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Nguyễn Văn An",
  "specialtyId": "11111111-1111-1111-1111-111111111111",
  "phoneNumber": "0900000000",
  "email": "an@clinic.vn"
}

### Xoá mềm bác sĩ
DELETE {{host}}/api/doctors/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

######################## Lịch khám ########################
# Thay patientId/doctorId bằng Id thật (lấy từ danh sách Bệnh nhân/Bác sĩ).

### Đặt lịch khám (lưu Id vào biến qua tên request "appt")
# @name appt
POST {{host}}/api/appointments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "patientId": "11111111-1111-1111-1111-111111111111",
  "doctorId": "22222222-2222-2222-2222-222222222222",
  "startTime": "2026-08-10T08:00:00Z",
  "endTime": "2026-08-10T08:30:00Z",
  "reason": "Khám tổng quát"
}

### Lấy Id lịch vừa tạo
@appointmentId = {{appt.response.body.$.data.id}}

### Danh sách/hàng đợi (lọc theo ngày + bác sĩ + trạng thái)
GET {{host}}/api/appointments?date=2026-08-10&status=0
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết lịch
GET {{host}}/api/appointments/{{appointmentId}}
Authorization: Bearer {{token}}
Accept: application/json

### Đổi khung giờ/lý do (reschedule)
PUT {{host}}/api/appointments/{{appointmentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "startTime": "2026-08-10T09:00:00Z",
  "endTime": "2026-08-10T09:30:00Z",
  "reason": "Đổi giờ"
}

### Check-in (Scheduled -> CheckedIn)
POST {{host}}/api/appointments/{{appointmentId}}/check-in
Authorization: Bearer {{token}}

### Bắt đầu khám (CheckedIn -> InProgress)
POST {{host}}/api/appointments/{{appointmentId}}/start
Authorization: Bearer {{token}}

### Hoàn tất (InProgress -> Completed)
POST {{host}}/api/appointments/{{appointmentId}}/complete
Authorization: Bearer {{token}}

### Huỷ lịch
POST {{host}}/api/appointments/{{appointmentId}}/cancel
Authorization: Bearer {{token}}

### Không đến
POST {{host}}/api/appointments/{{appointmentId}}/no-show
Authorization: Bearer {{token}}

### Xoá mềm lịch
DELETE {{host}}/api/appointments/{{appointmentId}}
Authorization: Bearer {{token}}
